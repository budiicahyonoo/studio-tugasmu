# Salin file ini ke .env dan isi nilai sesuai lingkungan Anda.
# Jangan pernah commit file .env ke repository.

# Neon PostgreSQL (Wajib)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Keamanan Sesi Admin (Wajib untuk produksi; minimal 32 karakter acak)
ADMIN_SESSION_SECRET="isi-string-acak-panjang-minimal-32-karakter"

# Kredensial Awal Admin untuk Seed (Opsional; jika kosong, seed tidak membuat akun default)
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="isi-password-admin-yang-kuat"

# Cloudinary untuk upload gambar portofolio, QRIS, dokumen, dan PDF Turnitin
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="nama-cloud-cloudinary"
CLOUDINARY_API_KEY="api-key-cloudinary"
CLOUDINARY_API_SECRET="api-secret-cloudinary"

# AI Perapian Deskripsi (Opsional; jika kosong, simulasi tetap berjalan memakai deskripsi asli)
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-..."

# Nomor WhatsApp cadangan jika pengaturan database belum dimuat
NEXT_PUBLIC_WHATSAPP_NUMBER="628xxxxxxxxxx"
